//@version=6
// Diagnostic: exercises every Pine output channel at once. Add to a chart and
// note which of the five things appear — that isolates which rendering layer
// is broken when a script attaches cleanly but nothing shows.
//   1. thick blue plot hugging the candles  (plot layer — cannot fail if the script runs)
//   2. orange striped background            (bgcolor layer)
//   3. huge yellow table DEAD CENTER        (table layer)
//   4. red "LABEL HERE" above the last bar  (label layer)
//   5. thick purple horizontal line         (line layer)
strategy("RenderTest", overlay = true)

plot(close, "test plot", color = color.blue, linewidth = 3)
bgcolor(bar_index % 10 < 5 ? color.new(color.orange, 85) : na)

var table t = table.new(position.middle_center, 1, 1, bgcolor = color.yellow)
if barstate.islast
    table.cell(t, 0, 0, "RENDER TEST · bars: " + str.tostring(bar_index + 1),
         text_color = color.black, text_size = size.huge)
    label.new(bar_index, high, "LABEL HERE", style = label.style_label_down,
         color = color.red, textcolor = color.white, size = size.large)
    line.new(bar_index - 50, close, bar_index, close, extend = extend.both,
         color = color.purple, width = 4)
